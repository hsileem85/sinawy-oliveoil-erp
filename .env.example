# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database URL
# Leave empty in local development to use embedded PGlite (real PostgreSQL stored in ./data/pgdata).
# Set this in production (Supabase, Neon, Railway, Render, Docker, or VPS PostgreSQL):
# DATABASE_URL=postgres://sinawy:sinawy_pass@localhost:5432/sinawy_erp
DATABASE_URL=

# Authentication & Security
JWT_SECRET=change-this-to-a-long-random-secret-in-production
ADMIN_EMAIL=admin@sinawy.net
ADMIN_PASSWORD=sinawy2026

# External REST API & EasyOrders Integration
ERP_API_KEY=snw_live_change_me_to_secure_key
EASYORDERS_WEBHOOK_SECRET=snw_eo_secret_change_me
