{
  "name": "sinawy-oliveoil-erp",
  "version": "1.0.0",
  "description": "Lightweight back-office ERP for Sinawy Olive Oil (sinawy.net) — Purchases, Bottling & Packaging, Multi-Channel Sales & EasyOrders API",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "migrate": "node server/migrate.js",
    "seed": "node server/seed.js",
    "test": "node server/tests/api.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
